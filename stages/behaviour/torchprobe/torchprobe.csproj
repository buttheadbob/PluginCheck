<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>PluginCheckProbe</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <DefineConstants>$(DefineConstants);TORCH</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Host.cs" />
    <Compile Include="../probe/src/Probe.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(LibFolder)/Torch*.dll" Private="false" />
    <Reference Include="$(LibFolder)/NLog.dll" Private="false" />
    <Reference Include="$(GameFolder)/Sandbox.*.dll" Private="false" />
    <Reference Include="$(GameFolder)/SpaceEngineers*.dll" Private="false" />
    <Reference Include="$(GameFolder)/VRage*.dll" Private="false" />
  </ItemGroup>
</Project>
